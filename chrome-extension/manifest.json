{
  "manifest_version": 3,
  "name": "VoicePilot — Voice Browser Control",
  "version": "0.23.0",
  "description": "Paired local desktop voice agent for Chrome. No remote servers in this extension.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VoicePilot"
  }
}